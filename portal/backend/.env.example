DATABRICKS_HOST=https://adb-xxxx.azuredatabricks.net
DATABRICKS_SP_CLIENT_ID=your-client-id
DATABRICKS_SP_CLIENT_SECRET=your-client-secret
DATABRICKS_SQL_WAREHOUSE_ID=your-warehouse-id
AWS_REGION=ap-northeast-1
AWS_SES_SENDER=noreply@portal.example.com
S3_VIDEO_BUCKET=portal-vehicle-videos
PORTAL_CATALOG=portal
OIDC_JWKS_URI=https://identitycenter.amazonaws.com/.../.well-known/jwks.json
OIDC_AUDIENCE=your-audience
DEV_MODE=true
DEV_USER_ID=dev-user-001
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME=開発ユーザー

# Vector Search (scene search)
# Backend: s3vectors | qdrant | pgvector | databricks
VECTOR_SEARCH_BACKEND=s3vectors
S3_VECTORS_BUCKET=portal-scene-vectors
S3_VECTORS_INDEX=video-frames
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=video-frames
PGVECTOR_CONNECTION_STRING=
DATABRICKS_VECTOR_SEARCH_ENDPOINT=
DATABRICKS_VECTOR_SEARCH_INDEX=

# Embedding Lambda
EMBEDDING_LAMBDA_NAME=portal-embedding
FRAME_EMBED_MODE=image_clip
EMBED_MODEL_NAME=openai/clip-vit-base-patch32
FRAME_EMBED_DIM=512

# Video clip
CLIP_MODE=browser_seek

# Genie Space IDs: JSON mapping of catalog_name -> Databricks Genie Space ID
# GENIE_SPACE_IDS={"vehicle_timeseries":"01abc...","fault_diagnostics":"02def..."}
GENIE_SPACE_IDS={}
